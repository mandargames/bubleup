    rightStrength: 5.8
    settling: 2.1
    damping: 0.78
    silverSeconds: 70
    goldSeconds: 36
    goldPumps: 15
    starsRequired: 1
  - id: water_03
    title: Side by Side
    chapter: FIND THE BALANCE
    lesson: Choose a side. Share the rings.
    hint: Dots below each peg show how many rings it holds.
    rings:
    - {x: -1.55, y: -1.85}
    - {x: 0, y: -1.85}
    - {x: 1.55, y: -1.85}
    pegs:
    - tip: {x: -1.1, y: 0.9}
