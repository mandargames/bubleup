  levels:
  - id: water_01
    title: First Splash
    chapter: FIRST SPLASH
    lesson: One ring. Find the rhythm.
    hint: Lift above the peg, then ease into the landing.
    rings:
    - {x: -1.1, y: -1.85}
    pegs:
    - tip: {x: 0, y: 0.9}
      length: 1.4
      capacity: 1
      movement: 0
      speed: 0.6
    baffles: []
    leftStrength: 5.8
    rightStrength: 5.8
    settling: 2.1
    damping: 0.78
    silverSeconds: 50
    goldSeconds: 22
    goldPumps: 8
    starsRequired: 0
  - id: water_02
    title: Double Dip
    chapter: FIND THE BALANCE
    lesson: Two rings, one satisfying stack.
    hint: Caught rings stay put. Guide the next one home.
    rings:
    - {x: -1.25, y: -1.85}
    - {x: 1.25, y: -1.85}
    pegs:
    - tip: {x: 0, y: 1.15}
      length: 1.65
      capacity: 2
      movement: 0
      speed: 0.6
