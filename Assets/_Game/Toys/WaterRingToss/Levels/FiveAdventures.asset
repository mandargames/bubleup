      movement: 0
      speed: 0.6
    - tip: {x: 1.1, y: 1.35}
      length: 1.8
      capacity: 2
      movement: 0
      speed: 0.6
    baffles: []
    leftStrength: 5.6
    rightStrength: 6.1
    settling: 2.1
    damping: 0.78
    silverSeconds: 95
    goldSeconds: 52
    goldPumps: 23
    starsRequired: 2
  - id: water_04
    title: The Scenic Route
    chapter: CHOOSE YOUR PATH
    lesson: Go around, then settle in.
    hint: Use the side channels to lift past the golden baffle.
    rings:
    - {x: -1.55, y: -1.85}
    - {x: 0, y: -1.85}
    - {x: 1.55, y: -1.85}
