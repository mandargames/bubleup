      movement: 0
      speed: 0.6
    - tip: {x: 1.18, y: 1.6}
      length: 1.35
      capacity: 1
      movement: 0
      speed: 0.6
    baffles:
    - center: {x: 0, y: -0.05}
      size: {x: 1.3, y: 0.18}
      angle: 8
    leftStrength: 5.8
    rightStrength: 5.8
    settling: 2.1
    damping: 0.78
    silverSeconds: 115
    goldSeconds: 65
    goldPumps: 30
    starsRequired: 3
  - id: water_05
    title: A Little Symphony
    chapter: MASTER THE TOY
    lesson: Four rings. Three pegs. Your rhythm.
    hint: The middle peg drifts gently. Anticipate its return.
    rings:
